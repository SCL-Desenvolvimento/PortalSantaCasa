{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://intranet.santacasalorena.org.br",
      "http://intranet.santacasalorena.org.br",
      "http://docker-w3.sp.santacasalorena.org.br:8085",
      "http://docker-w3.sp.santacasalorena.org.br:8086"
    ]
  },
  "Jwt": {
    "Issuer": "intranet.santacasalorena.org.br",
    "Audience": "intranet.santacasalorena.org.br"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "User": "intranet",
    "VirtualHost": "/",
    "UseSsl": false
  },
  "Upload": {
    "MultipartBodyLengthLimitBytes": 629145600,
    "MaxRequestBodySizeBytes": 629145600
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
